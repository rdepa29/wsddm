<Window x:Class="Wsddm.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSDDM"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Grid x:Name="Root">
        <Image x:Name="BlurBg" Stretch="Fill"
               RenderOptions.BitmapScalingMode="Linear" />
        <Rectangle x:Name="BgTint" />
        <StackPanel x:Name="CenterStack"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Border x:Name="WelcomePill"
                    CornerRadius="16"
                    Padding="28,12"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock x:Name="WelcomeTitle" Text="Welcome back,"
                               FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="WelcomeMsg"
                               FontFamily="Segoe UI" FontSize="14" Opacity="0.85" />
                </StackPanel>
            </Border>
            <Border x:Name="Card"
                    CornerRadius="28"
                    Padding="56,40"
                    MinWidth="420">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="ClockText"
                               FontFamily="Segoe UI Light" FontSize="84"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="DateText"
                               FontFamily="Segoe UI" FontSize="16" Opacity="0.8"
                               HorizontalAlignment="Center" Margin="0,2,0,24" />
                    <Grid Width="88" Height="88" Margin="0,0,0,12">
                        <Ellipse x:Name="Avatar" Stretch="UniformToFill" />
                        <TextBlock x:Name="AvatarInitial"
                                   FontFamily="Segoe UI" FontSize="36"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="UserText"
                               FontFamily="Segoe UI" FontSize="18"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <PasswordBox x:Name="PassBox"
                                 Width="280" Height="36" FontSize="15"
                                 HorizontalAlignment="Center" Padding="6,4"
                                 KeyDown="OnPassKeyDown" />
                    <TextBlock x:Name="HintText"
                               FontFamily="Segoe UI" FontSize="14" Opacity="0.75"
                               HorizontalAlignment="Center" Visibility="Collapsed"
                               Margin="0,14,0,0" />
                    <TextBlock x:Name="ErrorText"
                               FontFamily="Segoe UI" FontSize="14"
                               HorizontalAlignment="Center" Visibility="Collapsed"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>